<% layout("/layouts/boilerplate") %>

<style>
    .edit-page {
        max-width: 750px;
        margin: 40px auto;
        padding: 20px;
        font-family: inherit;
    }

    .edit-page h3 {
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 10px;
        color: #222;
    }

    .edit-subtitle {
        color: #777;
        margin-bottom: 25px;
        font-size: 15px;
    }

    .edit-card {
        background: #fff;
        padding: 30px;
        border: 1px solid #eee;
        border-radius: 15px;
        box-shadow: 0 5px 25px rgba(0, 0, 0, 0.06);
    }

    .edit-page .form-group {
        margin-bottom: 22px;
    }

    .edit-page label {
        display: block;
        font-weight: 600;
        margin-bottom: 9px;
        color: #333;
    }

    .edit-page input,
    .edit-page textarea {
        display: block;
        width: 100%;
        padding: 12px 14px;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 15px;
        box-sizing: border-box;
        font-family: inherit;
        background: #fff;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .edit-page textarea {
        min-height: 140px;
        resize: vertical;
    }

    .edit-page input:focus,
    .edit-page textarea:focus {
        outline: none;
        border-color: #fe424d;
        box-shadow: 0 0 0 3px rgba(254, 66, 77, 0.12);
    }

    .edit-page input[type="file"] {
        background: #fafafa;
        cursor: pointer;
    }

    .edit-page .form-note {
        margin-top: 8px;
        margin-bottom: 0;
        font-size: 13px;
        color: #777;
    }

    .edit-page .edit-btn {
        display: inline-block;
        background: #fe424d;
        color: #fff;
        border: none;
        border-radius: 25px;
        padding: 12px 30px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s, transform 0.2s;
    }

    .edit-page .edit-btn:hover {
        background: #e53640;
        transform: translateY(-1px);
    }

    .edit-page .cancel-link {
        display: inline-block;
        margin-left: 12px;
        color: #555;
        text-decoration: none;
        font-size: 14px;
    }

    .edit-page .cancel-link:hover {
        color: #fe424d;
        text-decoration: underline;
    }

    @media (max-width: 600px) {
        .edit-page {
            margin: 20px auto;
            padding: 12px;
        }

        .edit-page h3 {
            font-size: 25px;
        }

        .edit-card {
            padding: 20px;
        }
    }
</style>

<div class="edit-page">

    <h3>Edit your Listing</h3>

    <p class="edit-subtitle">
        Make changes to your property details below.
    </p>

    <div class="edit-card">

        <form
            method="POST"
            action="/listings/<%= listing._id %>?_method=PUT"
            enctype="multipart/form-data"
        >

            <!-- Listing Title -->
            <div class="form-group">
                <label for="title">Listing Title</label>

                <input
                    id="title"
                    name="listing[title]"
                    value="<%= listing.title %>"
                    type="text"
                    placeholder="Enter listing title"
                    required
                />
            </div>

            <!-- Description -->
            <div class="form-group">
                <label for="description">Description</label>

                <textarea
                    id="description"
                    name="listing[description]"
                    placeholder="Describe your property"
                ><%= listing.description %></textarea>
            </div>

            <!-- Image Upload -->
            <div class="form-group">
                <label for="image">Upload New Image (optional)</label>

                <input
                    name="image"
                    id="image"
                    type="file"
                    accept="image/png, image/jpeg"
                />

                <p class="form-note">
                    Leave this empty if you want to keep the current image.
                </p>
            </div>

            <!-- Price -->
            <div class="form-group">
                <label for="price">Price per night (₹)</label>

                <input
                    id="price"
                    name="listing[price]"
                    value="<%= listing.price %>"
                    type="number"
                    min="0"
                    placeholder="Enter price"
                    required
                />
            </div>

            <!-- Country -->
            <div class="form-group">
                <label for="country">Country</label>

                <input
                    id="country"
                    name="listing[country]"
                    value="<%= listing.country %>"
                    type="text"
                    placeholder="Enter country"
                    required
                />
            </div>

            <!-- Location -->
            <div class="form-group">
                <label for="location">Location</label>

                <input
                    id="location"
                    name="listing[location]"
                    value="<%= listing.location %>"
                    type="text"
                    placeholder="Enter location"
                    required
                />
            </div>

            <!-- Buttons -->
            <button class="edit-btn" type="submit">
                Save Changes
            </button>

            <a
                class="cancel-link"
                href="/listings/<%= listing._id %>"
            >
                Cancel
            </a>

        </form>

    </div>
</div>