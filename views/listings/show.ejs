
<% layout("/layouts/boilerplate") %>

<div class="show-page">

    <div class="show-container">

        <!-- PAGE HEADING -->
        <div class="show-heading">
            <p class="show-subtitle">WanderLust</p>
            <h1>Listing Details</h1>
        </div>

        <!-- LISTING CARD -->
        <div class="show-card">

            <!-- IMAGE -->
            <div class="show-image-container">
                            <img src="<%= listing.image.url || listing.image %>" alt="listing_image">

            </div>

            <!-- DETAILS -->
            <div class="show-content">

                <h2 class="show-title">
                    <%= listing.title %>
                </h2>

                <p class="show-description">
                    <%= listing.description %>
                </p>

                <div class="show-details">

                    <div class="detail-item">
                        <span class="detail-label">Price</span>
                        <span class="detail-value price">
                            &#8377; <%= listing.price.toLocaleString("en-IN") %>
                            <small>/ night</small>
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">Location</span>
                        <span class="detail-value">
                            <%= listing.location %>
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">Country</span>
                        <span class="detail-value">
                            <%= listing.country %>
                        </span>
                    </div>

                </div>

                <!-- ACTION BUTTONS -->
                <div class="show-actions">

                    <a
                        href="/listings/<%= listing._id %>/edit"
                        class="btn edit-btn"
                    >
                        Edit Listing
                    </a>

                    <form
                        method="POST"
                        action="/listings/<%= listing._id %>?_method=DELETE"
                    >
                        <button
                            type="submit"
                            class="btn delete-btn"
                        >
                            Delete Listing
                        </button>
                    </form>

                </div>

            </div>

        </div>

        <!-- BACK LINK -->
       <!-- MAP -->

<!-- MAP -->
<div class="map-section">
    <h3>Where you'll be</h3>

    <% if (
        listing.geometry &&
        listing.geometry.coordinates &&
        listing.geometry.coordinates.length === 2
    ) { %>

        <div id="map"
             data-map-token="<%= mapToken %>"
             data-coordinates="<%= JSON.stringify(listing.geometry.coordinates) %>"
             data-title="<%= listing.title %>"
             data-location="<%= listing.location %>"
             data-country="<%= listing.country %>">
        </div>

    <% } else { %>

        <p>Map location isn't available for this listing yet.</p>

    <% } %>
</div>
<!-- BACK LINK -->
<a href="/listings" class="back-link">
    ← Back to all listings
</a>

    </div>

</div>

<!-- REVIEW FORM -->
<div class="container mt-5 mb-5">

    <hr>

    <h3 class="mb-4">Leave a Review</h3>

    <form
        action="/listings/<%= listing._id %>/reviews"
        method="POST"
        class="review-form"
    >

        <div class="mb-3">
            <label for="rating" class="form-label">
                Rating (1–5)
            </label>

            <input
                type="number"
                id="rating"
                name="review[rating]"
                min="1"
                max="5"
                class="form-control"
                placeholder="Give a rating from 1 to 5"
                required
            >
        </div>

        <div class="mb-3">
            <label for="comment" class="form-label">
                Comment
            </label>

            <textarea
                id="comment"
                name="review[comment]"
                class="form-control"
                rows="4"
                placeholder="Share your experience..."
                required
            ></textarea>
        </div>

        <button type="submit" class="btn btn-success">
            Submit Review
        </button>

    </form>

    <hr class="my-5">

    <!-- REVIEWS DISPLAY -->
    <h3 class="mb-4">What People Think</h3>

    <% if (listing.reviews.length === 0) { %>

        <p class="text-muted">
            No reviews yet. Be the first to review!
        </p>

    <% } else { %>

        <div class="row">

            <% for (let review of listing.reviews) { %>

                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="card h-100 shadow-sm border-0">

                        <div class="card-body">

                            <!-- RATING -->
                            <h5 class="card-title mb-3">
                                ⭐ <%= review.rating %>/5
                            </h5>

                            <!-- COMMENT -->
                            <p class="card-text">
                                <%= review.comment %>
                            </p>

                            <!-- DELETE REVIEW -->
                            <form
                                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                method="POST"
                                onsubmit="return confirm('Are you sure you want to delete this review?');"
                            >
                                <button
                                    class="btn btn-outline-danger btn-sm"
                                    type="submit"
                                >
                                    Delete Review
                                </button>
                            </form>

                        </div>

                    </div>

                </div>

            <% } %>

        </div>

    <% } %>

</div>
<script src="https://api.mapbox.com/mapbox-gl-js/v3.14.0/mapbox-gl.js"></script>
<script src="/js/map.js"></script>
